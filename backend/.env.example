# Copy to .env and fill in real values. Never commit .env itself.
PORT=4000

# Needs the Directions API enabled in Google Cloud Console.
GOOGLE_MAPS_API_KEY=your_key_here

# Optional lightweight guard: if set, clients must send a matching 'secret'
# field on register or the backend disconnects them. Leave blank for local
# demos where anyone on your network is trusted.
REGISTRATION_SECRET=

# --- India-only speed assumptions (speedModel.js) ---
# Flat operating average assumed for every ambulance (km/h). Not derived per
# road — sirens + right-of-way let it ignore the posted limit.
AMBULANCE_SPEED_KMPH=60
# How many km/h under a road's (implied) speed limit a civilian car is
# simulated driving. There's no live per-segment speed-limit feed wired up
# here, so the "limit" is approximated from Google's own route duration.
SPEED_BELOW_LIMIT_KMPH=15

# --- Driving licence verification (dlVerificationService.js) ---
# Leave unset (or 'simulation') for the default: a format + presence check
# only, clearly marked as simulated in every result. Set to 'decentro' plus
# the three credentials below to call a real commercial KYC provider instead —
# that integration is UNTESTED (no Decentro account was available to verify
# it against); it falls back to simulation if the call fails.
DL_VERIFICATION_PROVIDER=simulation
DECENTRO_CLIENT_ID=
DECENTRO_CLIENT_SECRET=
DECENTRO_MODULE_SECRET=
# DECENTRO_BASE_URL=https://in.staging.decentro.tech

# --- Failed-to-give-way violations (violationService.js) ---
# How long (seconds) a vehicle has to clear a P1/P2 ambulance's immediate path
# before it's flagged. How close (metres) the ambulance must be for this to
# apply at all — this is about physically blocking it right now, separate
# from the route-level rerouting which acts from much farther away.
YIELD_GRACE_SECONDS=20
YIELD_ZONE_METERS=250
# "Sending to cops" is SIMULATED (logged to GET /violations) unless you
# `npm install nodemailer` and set these — there is no real government API to
# submit a challan to, so this is as far as an automated integration can go.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=ambulance-corridor@example.com
# POLICE_NOTIFY_EMAIL=

# --- Tuning knobs used mainly for automated testing (safe to leave unset) ---
# REROUTE_COOLDOWN_MS=15000
# NO_BETTER_ROUTE_BACKOFF_MS=45000
# ADVISORY_COOLDOWN_MS=20000

# --- Public link / deployment (see README, "Deploying") ---
# With NODE_ENV=production, /devices /history /violations /api-usage are OFF
# unless you set ADMIN_TOKEN; then they need ?token=<ADMIN_TOKEN>.
# ADMIN_TOKEN=
# Hard daily ceiling on Directions calls (UTC day); 0/unset = unlimited.
# DIRECTIONS_DAILY_LIMIT=1500
# Caps for a shared link:
# MAX_DEVICES=100
# ROUTE_REQUESTS_PER_MINUTE=30
# Where the local call counter is stored (default: backend/.directions-usage.json)
# DIRECTIONS_USAGE_FILE=
# Route-choice tuning (routingService.js). OVERLAP_PENALTY: metres of extra
# driving accepted to avoid 1 m of shared ambulance road when no route is fully
# clear (default 5; lower = shorter detours, more shared road). MAX_DETOUR_RATIO:
# optional cap on detour length vs the default route (e.g. 1.5); 0 = no cap.
# OVERLAP_PENALTY=5
# MAX_DETOUR_RATIO=0
